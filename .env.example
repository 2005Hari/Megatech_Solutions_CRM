# Postgres connection (pooled URL for the app) and direct URL (used by Prisma CLI for schema changes).
DATABASE_URL="postgresql://user:password@host:5432/megatech?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/megatech?schema=public"

# Sign-in. REQUIRED in production - without both of these the app refuses to serve
# any page (it fails closed). Leave both unset only for local development, where
# sign-in is switched off.
AUTH_PASSWORD="choose-a-strong-shared-password"
# Signs the session cookie. At least 16 characters; generate with:  openssl rand -base64 32
AUTH_SECRET=""

# WhatsApp requirement-to-quotation bot. Optional - the app works without it,
# the bot just stays off (the webhook returns 503). See README.md "WhatsApp bot".
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# ANTHROPIC_API_KEY - required for the WhatsApp bot (it calls Claude to parse the
# requirement text). Not needed for anything else in the app.
ANTHROPIC_API_KEY=""

# Base URL of this deployment, used only to build the "review this quotation" link
# the bot sends back on WhatsApp (e.g. "https://megatech-oms.vercel.app"). Optional.
APP_URL=""
