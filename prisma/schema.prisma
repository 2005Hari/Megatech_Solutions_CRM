generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum QuotationType {
  PRODUCT
  SERVICE
  MIXED
}

enum ItemType {
  PRODUCT
  SERVICE
}

/// Per-key running counters used to allocate collision-free reference numbers
/// (e.g. key "quotation-2026" -> MTS-2026-001). See src/lib/refs.ts.
model Counter {
  key   String @id
  value Int    @default(0)
}

model Unit {
  id     String  @id @default(uuid())
  name   String  @unique
  active Boolean @default(true)
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  defaultUnit String   @default("Nos")
  defaultRate Float    @default(0)
  sacCode     String?
  gstPct      Float    @default(18)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// The product catalogue. Quotation lines are picked from here by staff in the
/// builder, and matched against here by the WhatsApp bot. `catalogKey` is a
/// stable, human-readable identifier ("brand|name") used only to let the bot's
/// extraction model reference a product without relying on its UUID.
model Product {
  id          String   @id @default(uuid())
  catalogKey  String   @unique
  brand       String?
  name        String
  description String?
  defaultUnit String   @default("Nos")
  defaultRate Float    @default(0) // sell price
  defaultCost Float? // estimated cost, for expected-margin calculations
  sacCode     String? // HSN/SAC code
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

/// Staff WhatsApp numbers allowed to trigger the requirement-parsing bot.
/// The bot has no in-app review step before replying, so this allowlist is
/// the only gate between an inbound WhatsApp message and a created
/// quotation - every webhook request is checked against it.
model WhatsAppSender {
  id          String   @id @default(uuid())
  /// E.164 phone number as WhatsApp sends it (digits only, e.g. "919876543210")
  phoneNumber String   @unique
  label       String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

/// One row per staff WhatsApp number: the running conversation with the
/// agent, plus any destructive action waiting on a plain "yes" to confirm.
/// Conversation history is reset after a period of inactivity, and trimmed
/// to the most recent turns - see src/lib/whatsapp/conversation.ts.
model BotConversation {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  /// JSON array of Anthropic MessageParam-shaped turns (text and tool_use/tool_result blocks).
  messages    String   @default("[]")
  /// JSON: { tool, args, label } - set when a destructive tool call is
  /// awaiting an explicit "yes" in the NEXT message. Cleared on any reply,
  /// confirmed or not. Execution of the confirmed action does NOT go back
  /// through the model - see src/lib/whatsapp/agent.ts.
  pendingConfirmation String?
  pendingExpiresAt    DateTime?
  updatedAt           DateTime @updatedAt
}

enum BotActionStatus {
  IGNORED_UNAUTHORIZED
  OK
  FAILED
}

/// Audit trail for every inbound WhatsApp message the agent acted on (or
/// refused to act on), and every tool call it made answering it. There is
/// no human review before a tool runs (destructive ones aside - see
/// BotConversation.pendingConfirmation), so this is how staff can see what
/// the bot did and why.
model BotActionLog {
  id           String          @id @default(uuid())
  fromPhone    String
  userMessage  String
  status       BotActionStatus
  /// JSON array of {name, input, resultSummary, isError} - one per tool call made answering this message.
  toolCalls    String?
  replyText    String?
  errorMessage String?
  createdAt    DateTime        @default(now())

  @@index([fromPhone])
  @@index([createdAt])
}

model Customer {
  id             String       @id @default(uuid())
  name           String
  contactDetails String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  quotations     Quotation[]
  customerPOs    CustomerPO[]
}

model Supplier {
  id             String       @id @default(uuid())
  name           String
  contactDetails String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  supplierPOs    SupplierPO[]
}

model Quotation {
  id           String          @id @default(uuid())
  refNo        String          @unique
  date         DateTime        @default(now())
  validUntil   DateTime?
  status         String          @default("Draft") // Draft, Pending Approval, Sent, Customer Review, Negotiation, Revised, Won, Lost, Expired, Cancelled
  followupDate   DateTime?
  notes          String?
  salutation     String?
  subject        String?
  type           QuotationType   @default(PRODUCT)
  revision       Int             @default(0)
  parentQuotationId String?
  parentQuotation  Quotation?    @relation("RevisionHistory", fields: [parentQuotationId], references: [id])
  revisions        Quotation[]   @relation("RevisionHistory")
  includeGst     Boolean         @default(true)
  gstPct         Float           @default(18)
  includeFreight Boolean         @default(true)
  freightAmount  Float           @default(0)
  terms          String?         // JSON string array of terms
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  customerAddress String?        // free-text "To" block printed on the document
  sections       QuotationSection[]
  items          QuotationItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customerPOs    CustomerPO[]

  @@index([status])
  @@index([customerId])
  @@index([parentQuotationId])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sectionId   String?
  section     QuotationSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  type        ItemType  @default(PRODUCT)
  order       Int       @default(0)
  brand       String?
  productName String
  qty         Int
  unit        String?
  sellPrice   Float
  estimatedCost Float?
  laborCost     Float?
  materialCost  Float?
  transportCost Float?
  otherCost     Float?
}

model QuotationSection {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  items       QuotationItem[]
}

model CustomerPO {
  id          String           @id @default(uuid())
  refNo       String           @unique
  date        DateTime         @default(now())
  deliveryDate DateTime?
  status      String           @default("Open") // Open, Fulfilled, Cancelled
  notes       String?
  pdfAttached String?
  quotationId String?
  quotation   Quotation?       @relation(fields: [quotationId], references: [id])
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id])
  items       CustomerPOItem[]
  supplierPOs SupplierPO[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([quotationId])
  @@index([customerId])
}

model CustomerPOItem {
  id          String     @id @default(uuid())
  cpoId       String
  cpo         CustomerPO @relation(fields: [cpoId], references: [id], onDelete: Cascade)
  productName String
  qty         Int
  unit        String?
  sellPrice   Float
  estimatedCost Float?
  spoItems    SupplierPOItem[]
}

model SupplierPO {
  id           String           @id @default(uuid())
  refNo        String           @unique
  date         DateTime         @default(now())
  deliveryDate DateTime?
  status       String           @default("Draft") // Draft, Ready For Review, Sent, Partially Received, Fully Received, Closed
  notes        String?
  cpoId        String?
  cpo          CustomerPO?      @relation(fields: [cpoId], references: [id])
  supplierId   String?
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  items        SupplierPOItem[]
  statusHistory StatusHistory[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([cpoId])
  @@index([supplierId])
}

model SupplierPOItem {
  id          String     @id @default(uuid())
  spoId       String
  spo         SupplierPO @relation(fields: [spoId], references: [id], onDelete: Cascade)
  productName String
  qty         Int
  unit        String?
  buyPrice    Float?     // null = not priced yet (drafts have no commercials)
  cpoItemId   String?
  cpoItem     CustomerPOItem? @relation(fields: [cpoItemId], references: [id])
}

model StatusHistory {
  id        String     @id @default(uuid())
  spoId     String
  spo       SupplierPO @relation(fields: [spoId], references: [id], onDelete: Cascade)
  status    String
  createdAt DateTime   @default(now())
}
